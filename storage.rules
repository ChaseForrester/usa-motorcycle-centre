rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isPlatform() {
      return signedIn() && request.auth.token.role == 'platform';
    }

    function isSuperAdmin(tenantId) {
      return signedIn()
        && request.auth.token.role == 'superadmin'
        && request.auth.token.tenantId == tenantId;
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isPlatform() || (signedIn() && request.auth.token.role == 'superadmin');
    }

    // 100x150mm label PDFs. Shop Super Admin can open them. Buyers cannot.
    // Writes go through Cloud Functions with the Admin SDK.
    match /tenants/{tenantId}/labels/{fileName} {
      allow read: if isSuperAdmin(tenantId) || isPlatform();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
